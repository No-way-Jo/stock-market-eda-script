import os
import pandas as pd

# 1. Install required financial packages quietly within the script environment
print("Initializing environment and installing dependencies...")
os.system('pip install yfinance plotly pandas -q')

import yfinance as yf
import plotly.graph_objects as go
from plotly.subplots import make_subplots

# 2. Ingest live financial market data for Monster (MNST)
ticker = 'MNST'
print(f"Streaming live 12-month historical data for {ticker}...")
stock_data = yf.download(ticker, period='1y', interval='1d')

# Reset dataframe index to make 'Date' an accessible data column
stock_data = stock_data.reset_index()

# 3. Compute Foundational Technical Indicators
print("Calculating technical indicators (20-Day SMA & Rolling Volatility)...")
# Calculate the 20-Day Simple Moving Average
stock_data['SMA_20'] = stock_data['Close'].rolling(window=20).mean()

# Calculate Daily Returns and 20-Day Rolling Volatility Scale
stock_data['Daily_Return'] = stock_data['Close'].pct_change()
stock_data['Rolling_Volatility'] = stock_data['Daily_Return'].rolling(window=20).std()

# Clear out boundary rows containing missing values from rolling functions
stock_data.dropna(inplace=True)

# 4. Generate Interactive Financial Candlestick Dashboard
print("Generating high-aesthetic visual asset...")
fig = make_subplots(rows=2, cols=1, shared_xaxes=True, 
                    vertical_spacing=0.05, row_heights=[0.7, 0.3])

# Pane A: Candlestick Pricing Chart
fig.add_trace(go.Candlestick(
    x=stock_data['Date'],
    open=stock_data['Open'], high=stock_data['High'],
    low=stock_data['Low'], close=stock_data['Close'],
    name='MNST Price'
), row=1, col=1)

# Overlay: 20-Day Structural Trend Line
fig.add_trace(go.Scatter(
    x=stock_data['Date'], y=stock_data['SMA_20'],
    line=dict(color='#39FF14', width=2), # Custom Neon Green accent line matching Monster's branding
    name='20-Day SMA'
), row=1, col=1)

# Pane B: Daily Trading Volume Bar Chart
fig.add_trace(go.Bar(
    x=stock_data['Date'], y=stock_data['Volume'],
    marker_color='#1F2937', name='Volume'
), row=2, col=1)

# Apply Clean Corporate Dark Mode Styling Configurations
fig.update_layout(
    title=f'Executive Financial Analytics Audit: {ticker} Performance Profile',
    template='plotly_dark',
    xaxis_rangeslider_visible=False,
    height=600,
    margin=dict(l=50, r=50, t=80, b=50)
)

# 5. Export Summary Metrics and Save Layout File
print("Saving artifacts to directory...")
stock_data.to_csv('monster_market_metrics.csv', index=False)
fig.write_html('monster_stock_dashboard.html')

print("\nProcessing complete! 'monster_stock_dashboard.html' generated successfully.")
